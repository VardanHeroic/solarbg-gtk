<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="HomePage">
		<property name="layout-manager">
			<object class="GtkBoxLayout">
				<property name="orientation">horizontal</property>
				<property name="spacing">18</property>
			</object>
		</property>

		<child>
			<object class="GtkScrolledWindow">
				<property name="child">
					<object class="GtkListView">
						<property name="enable-rubberband">true</property>
						<property name="model">
							<object class="GtkMultiSelection">
								<property name="model" bind-source="HomePage"
									bind-property="themes" />
							</object>
						</property>
						<property name="factory">
							<object class="GtkBuilderListItemFactory">
								<property name="resource">/io/github/VardanHeroic/solarbg_gtk/ui/Theme.ui</property>
							</object>
						</property>
					</object>
				</property>
			</object>
		</child>
	</template>
</interface>
