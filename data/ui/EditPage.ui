<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="EditPage">
		<property name="layout-manager">
			<object class="GtkBinLayout">
				<!-- <property name="column-homogeneous">true</property> -->
				<!-- <property name="row-homogeneous">true</property> -->
			</object>
		</property>

		<child>
			<object class="GtkScrolledWindow">
				<property name="child">
					<object class="GtkListView">
						<property name="enable-rubberband">true</property>
						<property name="model">
							<object class="GtkMultiSelection">
								<property name="model" bind-source="EditPage" bind-property="themes" />
							</object>
						</property>
						<property name="factory">
							<object class="GtkBuilderListItemFactory">
								<property name="resource">/io/github/VardanHeroic/solarbg_gtk/ui/ThemeEntry.ui</property>
							</object>
						</property>
					</object>
				</property>
			</object>
		</child>
	</template>
</interface>
