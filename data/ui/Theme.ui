<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="GtkListItem">
		<property name="child">
			<object class="GtkBox">
				<property name="orientation">vertical</property>
				<property name="spacing">18</property>
				<child>
					<object class="GtkImage">
						<binding name="file">
							<lookup name="theme-thumbnail" type="Theme">
								<lookup name="item">GtkListItem</lookup>
							</lookup>
						</binding>
						<property name="pixel-size">200</property>
					</object>
				</child>
				<child>
					<object class="GtkLabel">
						<binding name="label">
							<lookup name="theme-name" type="Theme">
								<lookup name="item">GtkListItem</lookup>
							</lookup>
						</binding>
					</object>
				</child>
				<child>
					<object class="GtkButton">
						<property name="action-name">win.change-view</property>
						<property name="action-target">'edit'</property>
						<property name="label">Edit</property>
					</object>
				</child>
			</object>
		</property>
	</template>
</interface>
