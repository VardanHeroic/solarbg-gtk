<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="SolarbgWindow">
		<property name="child">
			<object class="GtkStack" id="stack">
				<child>
					<object class="GtkStackPage">
						<property name="name">edit</property>
						<property name="child">
							<!-- <object class="ThemeEntry"> -->
							<!-- 	<style> -->
							<!-- 	<class name="big"/> -->
							<!-- 	</style> -->
							<!-- 	<property name="file-name">hambal</property> -->
							<!-- 	<signal name="edit-cancel" handler="gotoHome" /> -->
							<!-- </object> -->
							<object class="EditPage" id="edit_page"></object>
						</property>
					</object>
				</child>
				<child>
					<object class="GtkStackPage">
						<property name="name">home</property>
						<property name="child">
							<object class="HomePage" id="home_page"></object>
						</property>
					</object>
				</child>
				<property name="visible-child-name">home</property>
			</object>
		</property>
	</template>
</interface>

