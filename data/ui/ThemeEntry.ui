<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="ThemeEntryRow" parent="GtkBox">
		<!-- <property name="child"> -->

		<!-- <object class="GtkBox"> -->
		<property name="orientation">horizontal</property>
		<property name="spacing">18</property>
		<child>
			<object class="GtkImage" id="image">
				<property name="pixel-size">200</property>
			</object>
		</child>
		<child>
			<object class="GtkLabel" id="name">

				<property name="wrap">true</property>
				<property name="justify">center</property>
			</object>
		</child>
		<child>
			<object class="GtkEntry">
				<property name="buffer">
					<object class="GtkEntryBuffer" id="start">
					</object>
				</property>
				<property name="input-purpose">GTK_INPUT_PURPOSE_NUMBER</property>
				<property name="halign">end</property>
			</object>
		</child>
		<child>
			<object class="GtkEntry">
				<property name="buffer">
					<object class="GtkEntryBuffer" id="end">
					</object>
				</property>
				<property name="input-purpose">GTK_INPUT_PURPOSE_NUMBER</property>
				<property name="halign">end</property>
			</object>
		</child>
		<child>
			<object class="GtkButton" id="delete_button">
				<!-- <property name="label"></property> -->
				<!-- <signal name="clicked" handler="onEntryRemoval" /> -->
				<property name="child">
					<object class="GtkImage">
						<property name="icon-name">edit-delete</property>
						<property name="icon-size">large</property>
					</object>
				</property>
				<!-- <property name="action-name">win.change-view</property> -->
				<!-- <property name="action-target">'home'</property> -->
			</object>
		</child>
		<!-- </object> -->
		<!-- </property> -->
	</template>
</interface>

